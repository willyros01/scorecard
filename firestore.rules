rules_version = '2';

/* LAST CHANGED FOR VERSION 2.0, PHASE D + GO-LIVE FIXES (Oct 1), PLUS PRIVATE GROUP REQUESTS (beta.3), PLUS COCKPIT AND AUTO APPLICATIONS (beta.4), PLUS THE DELETION LOCK (beta.9)
 *
 * beta.9 (Oct 2, approved by Willy): an account that has asked to be deleted
 * (accountDeletions/{uid} exists) is LOCKED. It is no longer a member of any
 * group in the eyes of these rules (no admin rights, no rounds, no games), and
 * it cannot join, claim, add, rename or register anything. It can still do
 * exactly what finishing its own deletion needs: read its own records, leave
 * its groups, remove its claims, pointers, blocks and email entry, and unlink
 * its golfer. It cannot withdraw the request once anything has been removed.
 *
 * beta.4 (Oct 1, approved by Willy): the cockpit and the applications switch.
 *   - The group creator may READ every group, its memberships and its rounds
 *     (the owner cockpit counts them). Read only.
 *   - A member stamps "last seen" on their own membership (that field only,
 *     the server's time).
 *   - settings/publicApplications: Manual or Auto and the daily limit; anyone
 *     may read it, Willy and the public group's reviewers change it.
 *   - Block lists (emails, domains, names): reviewers only.
 *   - accountEmails/{email}: one entry per account email, written by that
 *     account; anyone may ask about ONE email (the "already has an account"
 *     message), nobody can list them. An application is refused for an email
 *     that has one.
 *   - Auto: an applicant who confirmed their email (by the sign-in link) joins
 *     the public group by themselves, only when the switch is Auto and every
 *     Level 1 check passes, enforced here: name format and free, not blocked,
 *     under the daily limit (autoApprovals/{day}).
 *
 * beta.3 (Oct 1, approved by Willy): groupRequests/{email}. Anyone, even
 * signed out, may create ONE request for a private group (pending). Only the
 * group creator reads, decides (approving → approved, or declined) and deletes.
 *
 * Go-live fixes (review of Sep 30, approved by Willy):
 *   1. No signed-in account may read an unclaimed golfer any more. A named
 *      invitation is greeted from associations/{id}/invitations/{golferId},
 *      written by the owner or an admin when the invitation is sent.
 *   2. Approving a PUBLIC application is claimed (pending → approving) by one
 *      reviewer, then finished by that reviewer only; the approval document
 *      can be created once, only under that claim. Safe to retry; two
 *      reviewers cannot approve the same application.
 *
 * What changes in Phase D (Willy's rules, Sep 30):
 *   - Only accounts listed in groupCreators may create a group. The setup
 *     script lists Willy's account; no app can write the list.
 *   - The admin invitation secret moves from the group document (which every
 *     member can read) to associations/{id}/secrets/admin, which only the
 *     owner can read. So only the owner can send an admin invitation; admins
 *     invite regular members only.
 *   - Only the owner promotes or demotes (unchanged).
 *   - A group's admins may remove its regular members — never the owner, never
 *     another admin. (This replaces the PUBLIC-only rule of Phase C.)
 *   - The group creator (Willy) may list every golfer, as today, so the Tidy
 *     page keeps working unchanged. Nobody else may.
 *   - An owner or admin of a group a golfer plays in may archive that golfer
 *     (Tidy's merge and clean-up), changing nothing else. The live rules
 *     refused this whenever the golfer was off the roster, so Tidy's merge
 *     and unused-golfer clean-up never finished.
 *
 * What changes in Phase C (onboarding design Revision 2, R1-R3, R11, R12):
 *   - publicApplications/{email}: anyone, even signed out, may create ONE
 *     application (full name and email, status pending). Applicants can never
 *     read, change or delete it. Reviewers (admins of the PUBLIC group) read,
 *     approve, reject and delete.
 *   - publicApprovals/{email}: written by a reviewer on approval. Read by the
 *     account with that email once the email is confirmed, which then joins
 *     the PUBLIC group as the golfer the reviewer chose, and nobody else.
 *   - The PUBLIC group has the fixed id PUBLIC. No app can create a group with
 *     that id, nobody joins it with a code, and only its admins add golfers.
 *     Its admins may remove regular members.
 *   - Members of any group now read only their OWN membership; admins read
 *     all (a member list shows who is in the group, which strangers in the
 *     PUBLIC group must not see).
 *   - reports: a member may report a golfer's name to the group's admins
 *     (Apple guideline 1.2). userBlocks: each account keeps its own list of
 *     golfers it has blocked.
 *
 * What changes in Phase B (onboarding design Revision 2, R4 and R5):
 *   - Everything in the app now needs a real account: signed in with an email
 *     and password. An anonymous session (the old guest sign-in) is refused
 *     everywhere except the few reads and writes it needs to find its own
 *     groups and delete itself (Delete my account records its request before
 *     it attaches the throwaway email; see authed() below).
 *   - The check is the email on the sign-in token. A guest that sets an email
 *     and password keeps the SAME account and passes from then on; so does the
 *     throwaway credential Delete my account attaches.
 *
 * What changed in Phase A (onboarding design Revision 2):
 *   - rounds: readable only by an admin of the group, or by the golfer the
 *     round belongs to. The rule that let ANY signed-in account read every
 *     round in the database (the recursive rounds read) is removed.
 *   - golfers: a private record. Readable by its linked account, by admins of
 *     a group listed in its `groups`, or (single read, never a list) while it
 *     is still unclaimed so an invitation can greet the invitee.
 *   - directory: a new per-group list of name and handicap index only, which
 *     every member of the group may read. This is what regular members see.
 *   - games: readable by admins, and by members whose golfer is listed in the
 *     game's participantGolferIds.
 *   - golferNames: single reads only (the uniqueness check); nobody can list
 *     every name, and only the golfer or an admin can change or remove one.
 *   - invites: single reads by anyone signed in (as before); lists by members.
 *
 * Earlier history:
 *
 * This is here only so you can compare it against what is published in the
 * Firebase console if you are ever in doubt. It does NOT track the app version:
 * most releases change no rules at all, and there is nothing to republish for
 * those. The number only moves when these rules genuinely change, and Claude
 * says so at the top of the message when that happens.
 *
 * What changed in 2.22.0: two additions for the iPhone app's Delete my account.
 * A person may delete their OWN invitation claim, and may read and write their
 * OWN deletion request (accountDeletions/{uid}). Nothing else changed.
 *
 * What changed in 2.21.0: an account may read its OWN membership documents
 * wherever they are, so it can find its groups when the pointer list is
 * missing. Read only, and only your own.
 *
 * What changed in 2.19.14: an admin may now RELEASE a golfer's account link
 * (set it to nothing), which is what re-inviting somebody does. Seizing a link
 * is still refused.
 *
 * What changed in 2.19.5: members restricted to their OWN rounds; golfer edits
 * restricted (see the /golfers block); deleting a golfer closed entirely.
 */

/* The Scorecard — version 2 security rules.
 *
 * These are the enforcement layer. There is no server tier in this app, so
 * anything not enforced here is not enforced at all. App code runs on the
 * user's own phone and can be edited by anyone who cares to.
 *
 * Three things are enforced that the interface also shows, and must not be
 * trusted to the interface alone:
 *
 *   1. the join code           — checked here, never by app code
 *   2. the 24-hour edit window — measured against the server's clock
 *   3. the owner's permanence  — the owner cannot be demoted by anyone
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Phase B: a real account — signed in with an email and password. An
       anonymous session has no email on its token and is refused. */
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '') != '';
    }

    /* Any sign-in at all, anonymous included. Used ONLY where an old guest
       session must still be able to see its own groups and delete itself:
       its own deletion record, its own group list, its own membership
       documents, the groups it created, and the golfer linked to it. Every
       one of these is limited to the caller's own uid. */
    function authed() {
      return request.auth != null;
    }

    function memberPath(assocId) {
      return /databases/$(database)/documents/associations/$(assocId)/members/$(request.auth.uid);
    }

    /* beta.9: this account has asked to be deleted. */
    function deleting() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    /* beta.9: a deleting account is a member of nothing (see deleting()). */
    function isMember(assocId) {
      return signedIn() && exists(memberPath(assocId)) && !deleting();
    }

    function role(assocId) {
      return get(memberPath(assocId)).data.role;
    }

    function isAdmin(assocId) {
      return isMember(assocId) && (role(assocId) == 'admin' || role(assocId) == 'owner');
    }

    function isOwner(assocId) {
      return isMember(assocId) && role(assocId) == 'owner';
    }

    function association(assocId) {
      return get(/databases/$(database)/documents/associations/$(assocId)).data;
    }

    /* The golfer this account is linked to. A member may only touch their own
       rounds; anything wider is an admin's job. Costs one document read per
       write, which is the price of the rules being able to answer "is this
       yours?" at all. */
    function myGolfer(golferId) {
      return signedIn()
        && exists(/databases/$(database)/documents/golfers/$(golferId))
        && get(/databases/$(database)/documents/golfers/$(golferId)).data.linkedUid == request.auth.uid;
    }

    /* Rules cannot run a query, so they cannot ask "is this person an admin of
       ANY group holding this golfer?". The write therefore SAYS which group it
       acts for, in `editedIn`, and the rules verify the claim: you really are an
       admin there, and the golfer really is on that roster. A false claim fails
       both checks. */
    function editingAsAdmin(golferId) {
      return request.resource.data.editedIn is string
        && isAdmin(request.resource.data.editedIn)
        && exists(/databases/$(database)/documents/associations/$(request.resource.data.editedIn)/roster/$(golferId));
    }

    /* Admin of at least one of the groups a golfer plays in. Rules cannot loop,
       so the golfer record carries a short list of its groups (at most 10) and
       each entry is checked in turn. Repeated reads of one document count once
       toward Firestore's per-request limit. */
    function adminOfAny(groups) {
      return groups is list && (
           (groups.size() > 0 && isAdmin(groups[0]))
        || (groups.size() > 1 && isAdmin(groups[1]))
        || (groups.size() > 2 && isAdmin(groups[2]))
        || (groups.size() > 3 && isAdmin(groups[3]))
        || (groups.size() > 4 && isAdmin(groups[4]))
        || (groups.size() > 5 && isAdmin(groups[5]))
        || (groups.size() > 6 && isAdmin(groups[6]))
        || (groups.size() > 7 && isAdmin(groups[7]))
        || (groups.size() > 8 && isAdmin(groups[8]))
        || (groups.size() > 9 && isAdmin(groups[9])));
    }

    function golferDoc(golferId) {
      return get(/databases/$(database)/documents/golfers/$(golferId)).data;
    }

    /* An admin of a group this golfer plays in (looked up on the golfer). */
    function adminOfGolfer(golferId) {
      return signedIn()
        && exists(/databases/$(database)/documents/golfers/$(golferId))
        && adminOfAny(golferDoc(golferId).get('groups', []));
    }

    /* The golfer on this account's membership in a group. */
    function myGolferIn(assocId) {
      return get(memberPath(assocId)).data.get('golferId', '');
    }

    /* Phase D: the accounts allowed to create groups (Willy's). */
    function groupCreator() {
      return signedIn()
        && exists(/databases/$(database)/documents/groupCreators/$(request.auth.uid));
    }

    function adminSecret(assocId) {
      return get(/databases/$(database)/documents/associations/$(assocId)/secrets/admin).data;
    }

    /* Phase C: the PUBLIC group's fixed id, and the confirmed email of the
       caller as a document key (lower case). */
    function publicId() {
      return 'PUBLIC';
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function myEmailKey() {
      return request.auth.token.email.lower();
    }

    function approvalPath(emailKey) {
      return /databases/$(database)/documents/publicApprovals/$(emailKey);
    }

    function reviewer() {
      return isAdmin(publicId());
    }

    /* beta.4: Auto approvals. */
    function appPath(emailKey) {
      return /databases/$(database)/documents/publicApplications/$(emailKey);
    }

    function settingsDoc() {
      return get(/databases/$(database)/documents/settings/publicApplications).data;
    }

    /* (A missing settings document fails the read, which means: not Auto.) */
    function autoMode() {
      return settingsDoc().get('mode', 'manual') == 'auto';
    }

    /* Level 1 "Full name": two or more words, plain letters (hyphen and
       apostrophe allowed), 4-60 characters. Anything else waits for a person. */
    function validAutoName(n) {
      return n is string && n.size() >= 4 && n.size() <= 60
        && n.matches("[A-Za-z][A-Za-z'-]*( [A-Za-z][A-Za-z'-]*)+");
    }

    /* The same key the app makes (model.nameKey) for a plain-letter name. */
    function autoNameKey(n) {
      return n.lower().replace('[^a-z0-9]+', '-').replace('^-+|-+$', '');
    }

    function todayKey() {
      return string(int(request.time.toMillis() / 86400000));
    }

    function counterPath() {
      return /databases/$(database)/documents/autoApprovals/$(todayKey());
    }

    /* The applicant's own automatic approval, written in one batch with the
       golfer, the name claim and the day's counter. */
    function autoSelfApproval(emailKey) {
      return verifiedEmail()
        && myEmailKey() == emailKey
        && autoMode()
        && request.resource.data.keys().hasOnly(['golferId', 'displayName', 'nameKey', 'approvedBy', 'approvedAt', 'auto'])
        && request.resource.data.auto == true
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && get(appPath(emailKey)).data.status == 'pending'
        && validAutoName(get(appPath(emailKey)).data.fullName)
        && request.resource.data.displayName == get(appPath(emailKey)).data.fullName
        && request.resource.data.nameKey == autoNameKey(get(appPath(emailKey)).data.fullName)
        && getAfter(/databases/$(database)/documents/golferNames/$(request.resource.data.nameKey)).data.golferId == request.resource.data.golferId
        && getAfter(/databases/$(database)/documents/golfers/$(request.resource.data.golferId)).data.linkedUid == request.auth.uid
        && !exists(/databases/$(database)/documents/blockedEmails/$(emailKey))
        && !exists(/databases/$(database)/documents/blockedDomains/$(emailKey.split('@')[1]))
        && !exists(/databases/$(database)/documents/blockedNames/$(request.resource.data.nameKey))
        /* The day's counter must be written in this same batch (its rule
           makes it move by exactly one, stamped with this account and this
           moment), and stay within the limit. */
        && getAfter(counterPath()).data.lastBy == request.auth.uid
        && getAfter(counterPath()).data.lastAt == request.time
        && getAfter(counterPath()).data.count <= settingsDoc().get('dailyLimit', 20);
    }

    /* The counter moves only together with that approval. */
    function autoApprovalInThisBatch() {
      return verifiedEmail()
        && !exists(approvalPath(myEmailKey()))
        && getAfter(approvalPath(myEmailKey())).data.get('auto', false) == true;
    }

    /* beta.10. Legacy code entry remains available for regular members only.
       The deployment marker retires old named/admin URLs; new links contain
       no shared group/admin code. Tests exercise both migration states. */
    function invitationLinksV2() {
      return exists(/databases/$(database)/documents/settings/invitationLinks)
        && get(/databases/$(database)/documents/settings/invitationLinks).data.version == 2;
    }
    function tokenPath(a, token) {
      return /databases/$(database)/documents/associations/$(a)/invitationTokens/$(token);
    }
    function inviteMemberPath(a) {
      return /databases/$(database)/documents/associations/$(a)/members/$(request.auth.uid);
    }
    function pendingInvite(a, token) {
      let t = get(tokenPath(a, token)).data;
      return signedIn() && !deleting() && a != publicId()
        && t.state == 'pending'
        && get(/databases/$(database)/documents/associations/$(a)/invitationSlots/$(t.slot)).data.token == token;
    }
    function manualGolferClaim(golferId) {
      let a = request.resource.data.get('claimedIn', '');
      let m = get(inviteMemberPath(a)).data;
      return a != publicId() && m.role == 'member'
        && m.get('invitationToken', '') == ''
        && m.joinCode == association(a).joinCode
        && exists(/databases/$(database)/documents/associations/$(a)/roster/$(golferId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid','claimedIn']);
    }
    function joinedWithToken(a, token) {
      let t = get(tokenPath(a, token)).data;
      let m = getAfter(inviteMemberPath(a)).data;
      return pendingInvite(a, token)
        && m.uid == request.auth.uid && m.invitationToken == token
        && m.get('golferId', null) == t.golferId
        && getAfter(tokenPath(a, token)).data.state == 'used';
    }

    /* The edit window runs from entry time, not the date played, and is
       measured against request.time — the server's clock, not the device's. */
    function withinEditWindow() {
      return resource.data.enteredAt != null
        && request.time < resource.data.enteredAt + duration.value(24, 'h');
    }

    /* ---------------- associations ---------------- */

    match /associations/{assocId} {

      /* Members can read it. So can whoever created it, even if the
         membership write never happened — that is what makes an abandoned
         group findable and removable instead of stranded forever. */
      allow read: if isMember(assocId)
        || (authed() && resource.data.ownerUid == request.auth.uid)
        /* beta.4: the owner cockpit (read only). */
        || groupCreator();

      /* Phase C: never the PUBLIC group's id — that group is created once, by
         the owner's setup script. */
      /* Phase D: only a group creator, and never with the admin secret on the
         group document itself. */
      allow create: if groupCreator()
        && assocId != publicId()
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['adminCode']);

      /* The owner may rename the group or rotate the join code, but may not
         hand ownership away by editing this document. */
      allow update: if isOwner(assocId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        /* Phase D: the admin secret may only stay as it was or be removed
           (moved to secrets/admin), never set here again. */
        && request.resource.data.get('adminCode', null) in [null, resource.data.get('adminCode', null)];

      /* Only whoever created it, and only ever their own. Needed so the
         cleanup tool can remove groups that failed to set up properly. */
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      /* ---------------- members ---------------- */

      match /members/{memberUid} {

        /* Phase C: your own membership, or all of them if you are an admin. */
        allow read: if isAdmin(assocId)
          || (signedIn() && memberUid == request.auth.uid)
          || (signedIn() && association(assocId).ownerUid == request.auth.uid)
          /* beta.4: the owner cockpit (read only). */
          || groupCreator();

        /* Two ways a membership is created, and only ever for yourself.
         *
         * 1. The owner. Whoever created the group writes their own membership
         *    as owner. Proven against ownerUid on the group document, which
         *    only they could have set, because creating the group required it
         *    to equal their own account.
         *
         * 2. Everybody else. They present the join code and ask for the
         *    ordinary member role. The rules can read the group document to
         *    compare codes even though that person cannot read it themselves,
         *    so the code is never exposed.
         *
         * The owner case was missing before, which meant creating a group
         * always failed at this step and left the group behind with nobody in
         * it. */
        allow create: if signedIn() && !deleting()
          && memberUid == request.auth.uid
          && (
            (request.resource.data.role == 'owner'
              && association(assocId).ownerUid == request.auth.uid)
            ||
            (assocId != publicId()
              && request.resource.data.role == 'member'
              && request.resource.data.joinCode == association(assocId).joinCode
              && (!invitationLinksV2() || request.resource.data.get('golferId', null) == null))
            ||
            /* An admin invitation carries a DIFFERENT secret. Checking it here
               is what makes a pre-set role safe: a guest link cannot be edited
               into an admin one, because the guest code will not match. */
            (assocId != publicId()
              && request.resource.data.role == 'admin'
              && exists(/databases/$(database)/documents/associations/$(assocId)/secrets/admin)
              && request.resource.data.joinCode == adminSecret(assocId).adminCode
              && !invitationLinksV2())
            ||
            (request.resource.data.uid == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid', 'displayName', 'role', 'golferId', 'invitationToken', 'joinedAt'])
              && request.resource.data.joinedAt == request.time
              && request.resource.data.role == get(tokenPath(assocId, request.resource.data.invitationToken)).data.role
              && joinedWithToken(assocId, request.resource.data.invitationToken))
            ||
            /* Phase C: an approved applicant joins the PUBLIC group, as the
               golfer the reviewer chose, once their email is confirmed. */
            (assocId == publicId()
              && request.resource.data.role == 'member'
              && verifiedEmail()
              && exists(approvalPath(myEmailKey()))
              && request.resource.data.golferId == get(approvalPath(myEmailKey())).data.golferId
              && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'joinedAt', 'golferId'])
              && request.resource.data.uid == request.auth.uid)
          );

        /* Only the owner changes roles, and never the owner's own.
           Phase A: a member may also record WHICH golfer they are on their own
           membership (golferId), and nothing else, and only a golfer that is
           really linked to their account. Games use it to tell who played. */
        allow update: if (signedIn() && !deleting() && memberUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitationToken', 'golferId'])
            && joinedWithToken(assocId, request.resource.data.invitationToken))
          || (isOwner(assocId)
            && memberUid != association(assocId).ownerUid)
          || (signedIn() && !deleting() && memberUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['golferId'])
              && myGolfer(request.resource.data.golferId))
          /* beta.4: "last seen" on your own membership, the server's time. */
          || (signedIn() && !deleting() && memberUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
              && request.resource.data.lastSeenAt == request.time);

        /* People may leave; the owner may remove others; the owner cannot be
           removed by anybody, including themselves. */
        allow delete: if (memberUid != association(assocId).ownerUid
            && (memberUid == request.auth.uid || isOwner(assocId)))
          /* Phase D: a group's admins may remove its regular members. */
          || (isAdmin(assocId) && resource.data.role == 'member')
          /* or the owner clearing the group out before deleting it */
          || (signedIn() && association(assocId).ownerUid == request.auth.uid);
      }

      /* ---------------- Phase D: the owner's secrets ---------------- */

      /* The admin invitation secret. Only the owner reads or changes it, so
         only the owner can send an admin invitation. */
      match /secrets/{secretId} {
        allow read, write: if isOwner(assocId);
      }

      /* Independent secrets. Used records are permanent, contain no acceptor
         UID/email, and are never reopened by account deletion or resend. */
      match /invitationTokens/{token} {
        allow get: if signedIn() && (isAdmin(assocId) || resource.data.state != 'pending'
          || get(/databases/$(database)/documents/associations/$(assocId)/invitationSlots/$(resource.data.slot)).data.token == token);
        allow list: if isAdmin(assocId);
        allow create: if isAdmin(assocId) && assocId != publicId()
          && token.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['slot','golferId','role','name','handicapIndex','groupName','state','sentBy','sentAt'])
          && request.resource.data.state == 'pending'
          && request.resource.data.sentBy == request.auth.uid
          && request.resource.data.sentAt == request.time
          && request.resource.data.role in ['member','admin']
          && (request.resource.data.role == 'member' || isOwner(assocId))
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.groupName is string && request.resource.data.groupName.size() <= 120
          && ((request.resource.data.golferId == null && request.resource.data.slot == 'open-' + request.resource.data.role)
            || (request.resource.data.golferId is string
              && request.resource.data.slot == request.resource.data.golferId
              && exists(/databases/$(database)/documents/associations/$(assocId)/roster/$(request.resource.data.golferId))))
          && getAfter(/databases/$(database)/documents/associations/$(assocId)/invitationSlots/$(request.resource.data.slot)).data.token == token;
        allow update: if (signedIn() && !deleting()
          && resource.data.state == 'pending' && request.resource.data.state == 'used'
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','usedAt'])
          && joinedWithToken(assocId, token))
          || (isAdmin(assocId) && resource.data.state == 'pending'
            && request.resource.data.state == 'revoked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']));
        allow delete: if false;
      }
      match /invitationSlots/{slot} {
        allow read: if isAdmin(assocId);
        allow create, update: if isAdmin(assocId)
          && request.resource.data.keys().hasOnly(['token'])
          && getAfter(tokenPath(assocId, request.resource.data.token)).data.state == 'pending'
          && getAfter(tokenPath(assocId, request.resource.data.token)).data.slot == slot;
        allow delete: if isAdmin(assocId);
      }

      /* ---------------- invitation records (go-live fix 1) ---------------- */

      /* Written when the owner or an admin sends a named invitation: only
         what the invitee needs to see before joining (their name, index and
         the group's name). Read one at a time by its id, which only the link
         carries; never listed except by the group's admins. Admins write
         member invitations only; the owner may write either. */
      match /invitations/{golferId} {
        allow get: if signedIn();
        allow list: if isAdmin(assocId);
        allow create, update: if isAdmin(assocId)
          && request.resource.data.keys().hasOnly(['golferId', 'name', 'handicapIndex', 'groupName', 'role', 'sentBy', 'sentAt'])
          && request.resource.data.golferId == golferId
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.get('groupName', '') is string && request.resource.data.get('groupName', '').size() <= 120
          && request.resource.data.role in ['member', 'admin']
          && (request.resource.data.role == 'member' || isOwner(assocId))
          && request.resource.data.sentBy == request.auth.uid
          && exists(/databases/$(database)/documents/associations/$(assocId)/roster/$(golferId));
        allow delete: if isAdmin(assocId);
      }

      /* ---------------- invitation claims ---------------- */

      /* One document per invited golfer, recording which account accepted.
       *
       * This is what makes a named invitation safe to forward by accident: the
       * claim is written in the same batch as the membership, so whoever
       * accepts first owns it. A guest link stays usable by that same account
       * on another device; an admin link is spent.
       *
       * Readable by anyone signed in, because somebody holding a link must be
       * able to discover it is already taken before they try. */
      match /invites/{golferId} {
        allow get: if signedIn();
        /* beta.9: also your OWN claims (a query where acceptedBy is you), which
           Delete my account needs once the account is locked. */
        allow list: if isMember(assocId)
          || (signedIn() && resource.data.acceptedBy == request.auth.uid);

        /* Create only if nobody has claimed it, and only for yourself. */
        allow create: if signedIn() && !deleting()
          && request.resource.data.acceptedBy == request.auth.uid;

        /* Update only by the account that already holds it — this is what lets
           a guest re-use their own link on a second device, and what stops
           anybody else using it at all. */
        allow update: if signedIn() && !deleting()
          && resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.role != 'admin';

        allow delete: if isOwner(assocId) || (signedIn() && resource.data.acceptedBy == request.auth.uid);
      }

      /* ---------------- roster: which golfers play in this group ---------------- */

      /* Just a list of ids. The golfers themselves live at the top level,
         because a person belongs to no single group. */
      match /roster/{golferId} {
        allow read: if isMember(assocId);
        /* Phase C: in the PUBLIC group only its admins add golfers. */
        allow create, update: if (signedIn() && !deleting()
            && getAfter(inviteMemberPath(assocId)).data.golferId == golferId
            && joinedWithToken(assocId, getAfter(inviteMemberPath(assocId)).data.invitationToken))
          || (isMember(assocId)
          && (assocId != publicId() || isAdmin(assocId)))
          /* beta.4: an automatically approved applicant puts their own golfer
             on the public roster. */
          || (assocId == publicId()
              && myGolfer(golferId)
              && (isMember(assocId)
                  || (exists(approvalPath(myEmailKey()))
                      && get(approvalPath(myEmailKey())).data.golferId == golferId)));
        allow delete: if isAdmin(assocId)
          || (signedIn() && association(assocId).ownerUid == request.auth.uid);
      }

      /* ---------------- rounds ---------------- */

      match /rounds/{roundId} {
        /* Phase A: an admin sees the group's rounds; everybody else only their
           own golfer's. A regular member's app must query where golferId is
           their own golfer, or the whole query is refused. */
        allow read: if isAdmin(assocId)
          || (isMember(assocId) && myGolfer(resource.data.golferId));
        /* The owner may clear these out when deleting the whole group. */
        allow delete: if signedIn() && association(assocId).ownerUid == request.auth.uid;

        /* enteredBy cannot be forged, and enteredAt must be the server's
           timestamp — otherwise a device could set it in the future and give
           itself an indefinite edit window. */
        /* Admins post for anybody. A guest posts only for themselves — the
           screen already enforces this, but a screen is not a safeguard. */
        allow create: if isMember(assocId)
          && request.resource.data.enteredBy == request.auth.uid
          && request.resource.data.enteredAt == request.time
          && request.resource.data.assocId == assocId
          && (isAdmin(assocId) || myGolfer(request.resource.data.golferId));

        /* Any member may correct any round for 24 hours after it was entered.
           This follows from "anyone can post for everybody" — the same people
           who can enter a score can fix it. Admins are not time limited. */
        /* A member may correct their OWN round for 24 hours. Not anybody
           else's — that was far too wide, and meant one careless guest could
           edit the whole group's scores. Admins remain unrestricted, because
           entering and fixing other people's cards is their job. */
        allow update: if isAdmin(assocId)
          || (isMember(assocId) && withinEditWindow()
              && myGolfer(resource.data.golferId)
              && request.resource.data.golferId == resource.data.golferId
              && request.resource.data.enteredAt == resource.data.enteredAt
              && request.resource.data.enteredBy == resource.data.enteredBy);

        allow delete: if isAdmin(assocId)
          || (isMember(assocId) && withinEditWindow() && myGolfer(resource.data.golferId));
      }

      /* ---------------- directory: name and index only ---------------- */

      /* What a regular member may see of the other golfers in the group:
         display name and handicap index, and nothing else. Firestore cannot
         hide fields of a document, so private golfer data never goes here. */
      match /directory/{golferId} {
        allow read: if isMember(assocId);
        allow create, update: if isAdmin(assocId)
          || (isMember(assocId)
              && myGolfer(golferId)
              && request.resource.data.keys().hasOnly(['golferId', 'displayName', 'handicapIndex', 'updatedAt'])
              && request.resource.data.golferId == golferId);
        allow delete: if isAdmin(assocId)
          || (signedIn() && association(assocId).ownerUid == request.auth.uid);
      }

      /* ---------------- reports (Apple guideline 1.2) ---------------- */

      /* A member reports a golfer's name to the group's admins. Only the
         admins read them; nobody can change one. */
      match /reports/{reportId} {
        allow create: if isMember(assocId)
          && request.resource.data.keys().hasOnly(['golferId', 'displayName', 'reason', 'reportedBy', 'createdAt'])
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.golferId is string
          && request.resource.data.golferId.size() <= 128
          && request.resource.data.get('displayName', '') is string
          && request.resource.data.get('displayName', '').size() <= 120
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500;
        allow read, delete: if isAdmin(assocId);
      }

      /* ---------------- games ---------------- */

      match /games/{gameId} {
        /* Phase A: admins, the game's creator, and members who played in it.
           The shared result sheet lives on the game document itself
           (published by an admin), so reading it never opens anybody's rounds. */
        allow read: if isAdmin(assocId)
          || (isMember(assocId) && (
               resource.data.get('createdBy', '') == request.auth.uid
               || myGolferIn(assocId) in resource.data.get('participantGolferIds', [])));
        allow create: if isMember(assocId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdmin(assocId)
          || (isMember(assocId) && resource.data.createdBy == request.auth.uid)
          || (signedIn() && association(assocId).ownerUid == request.auth.uid);
      }
    }

    /* ---------------- golfers: people, not group members ---------------- */

    /* A golfer exists once, at the top level, and carries one handicap index
     * built from their last twenty rounds wherever those were played.
     *
     * This is the only structure that produces a correct index for somebody
     * who plays in more than one group. Storing golfers under a group would
     * give them one index per group, each computed from a slice of their golf
     * and none of them their actual handicap.
     *
     * Readable and writable by anyone signed in, because posting a round for
     * a playing partner has to move that partner's index, and the partner may
     * be in a group you are not. Deleting is not permitted from the app —
     * rounds reference golfers, and an orphaned round has no owner. */
    match /golfers/{golferId} {
      /* A private record: its own account, or admins of a group it plays in.
         Go-live fix 1: the exception that let any signed-in account read an
         UNCLAIMED golfer (to greet an invitee) is gone; the greeting now comes
         from the invitation record (associations/{id}/invitations/{golferId}). */
      allow get: if signedIn() && (
        resource.data.get('linkedUid', null) == request.auth.uid
        || adminOfAny(resource.data.get('groups', [])));
      /* Lists only of your OWN golfer (a query where linkedUid is you) — how
         the app finds which golfer you are, and what Delete my account uses. */
      /* Phase D (Willy's choice B): the group creator may also list every
         golfer, as today, so Tidy keeps working unchanged. Nobody else. */
      allow list: if (authed() && resource.data.get('linkedUid', null) == request.auth.uid)
        || groupCreator();

      /* Creating is an everyday act — adding a person to a roster. The name
         index below stops duplicates. */
      allow create: if signedIn() && !deleting();

      /* Updating WAS open to any signed-in account anywhere, which meant
         somebody in an unrelated group — or an anonymous session belonging to
         no group at all — could rename or overwrite any golfer in the whole
         database. Three legitimate cases now:
           1. it is your own linked golfer;
           2. you are claiming an unlinked golfer as yourself, which is how
              accepting a named invitation works;
           3. you administer a group this golfer plays in, and you say which. */
      /* beta.9: a deleting account may only UNLINK its own golfer (the last
         step of its deletion), changing nothing else. */
      allow update: if signedIn() && deleting()
        && resource.data.linkedUid == request.auth.uid
        && request.resource.data.linkedUid == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid']);
      allow update: if signedIn() && !deleting() && (
        resource.data.linkedUid == request.auth.uid
        || (resource.data.linkedUid == null
            && request.resource.data.linkedUid == request.auth.uid
            && (!invitationLinksV2()
              || (verifiedEmail() && exists(approvalPath(myEmailKey()))
                && get(approvalPath(myEmailKey())).data.golferId == golferId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid']))
              || manualGolferClaim(golferId)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid','claimedIn','claimedToken'])
                && joinedWithToken(request.resource.data.claimedIn, request.resource.data.claimedToken)
                && get(tokenPath(request.resource.data.claimedIn, request.resource.data.claimedToken)).data.golferId == golferId)))
        || (request.resource.data.linkedUid == resource.data.linkedUid
            && editingAsAdmin(golferId))
        /* An admin may RELEASE a link — set it to nothing — which is what
           re-inviting somebody does. Releasing grants the admin nothing, so it
           is safe; SEIZING a link (pointing it at themselves) is still refused
           by the branch above, which requires the link to be unchanged. */
        || (request.resource.data.linkedUid == null
            && editingAsAdmin(golferId))
        /* Phase D: an owner or admin of a group this golfer plays in (from the
           golfer's own list of groups) may ARCHIVE it — Tidy's merge and
           clean-up — changing nothing else. The roster check above cannot
           allow this: a merged duplicate has just left the roster, and an
           unused golfer was never on one. */
        || (adminOfAny(resource.data.get('groups', []))
            && request.resource.data.get('archived', false) == true
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['archived', 'archivedAt', 'nameKey', 'mergedInto', 'editedIn']))
      );

      /* CLOSED, deliberately. A delete carries no data, so the rules have
         nothing to check beyond "somebody is signed in" — exactly the hole that
         let any account remove any golfer in the database. There is no way to
         make it safe, so tidy.html ARCHIVES an unused golfer instead: an
         update, which the rules above can verify properly. */
      allow delete: if false;
    }


    /* Name uniqueness. One document per name, so two people cannot both be
       "Willy Rosales" and rounds can never be filed against the wrong one.
       Firestore refuses a second document with the same id, which is what
       makes the guarantee real rather than a check the app could skip. */
    match /golferNames/{nameKey} {
      /* Phase A: single reads only (the uniqueness check); nobody can list
         every name in the database. Creating a claim is open to a signed-in
         account (adding or joining as a golfer); changing or removing one is
         for that golfer's own account or an admin of a group it plays in. */
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && !deleting() && request.resource.data.golferId is string;
      allow update, delete: if signedIn() && !deleting() && (
        myGolfer(resource.data.golferId) || adminOfGolfer(resource.data.golferId));
    }

    /* ---------------- finding rounds wherever they are ---------------- */

    /* Lets a signed-in person search every "rounds" collection at once,
     * whichever group holds it.
     *
     * This exists for recovery. Rounds live inside a group, so if a group
     * document is lost its rounds become unreachable — present in the database
     * but invisible to every normal query, which is exactly the state the app
     * ended up in. Without this rule the rescue scan is refused and there is no
     * way to even find out whether they survived.
     *
     * Read only, and only for a signed-in account. Nothing can be written or
     * deleted through this path. */
    /* Lets an account find every group it belongs to, whichever group holds the
     * membership.
     *
     * The app normally reads a pointer list at /userGroups/{uid}/groups. That
     * pointer can go missing — it did, for somebody promoted to admin — and
     * without it the app concluded they belonged to NOWHERE and offered to
     * create a group, which would have split their data in two.
     *
     * This is narrow on purpose: you may read a membership document only if it
     * is YOUR OWN, so it reveals nothing about anybody else. Read only. */
    match /{path=**}/members/{memberUid} {
      /* 2.22.0 fix: the app finds its memberships with a query on the uid
         FIELD (where uid == me). The rules cannot match a field filter against
         the document id, so that query was always refused — which stopped
         Delete my account at its first step. The uid field is checked too. */
      allow read: if (authed()
        && (memberUid == request.auth.uid || resource.data.get('uid', '') == request.auth.uid))
        /* beta.4: the owner cockpit (read only). */
        || groupCreator();
    }

    /* beta.4: the owner cockpit counts rounds across groups. Read only, and
       only for the group creator. */
    match /{path=**}/rounds/{roundId} {
      allow read: if groupCreator();
    }

    /* Phase A: the recursive rounds read that let ANY signed-in account read
       every round in the database is removed. Rebuild the roster now reads
       only the groups its admin manages. */

    /* ---------------- which groups an account belongs to ---------------- */

    /* A list kept per account rather than per device. Without it, signing in on
       a second device finds nothing, because the device's own list is empty —
       which is exactly what happened between Safari and the home-screen app.
       Yours only, readable and writable by nobody else. */
    match /userGroups/{userId}/groups/{assocId} {
      allow read: if authed() && userId == request.auth.uid;
      /* Deleting your own entry is part of Delete my account. Adding one
         needs a real account. */
      allow delete: if authed() && userId == request.auth.uid;
      allow create, update: if signedIn() && !deleting() && userId == request.auth.uid;
    }

    /* ---------------- Phase C: the PUBLIC group ---------------- */

    /* One application per email, created without signing in. Full name and
       email only; no password, no account yet (R1, R3). */
    match /publicApplications/{emailKey} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'email', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['fullName', 'email', 'status', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.lower() == emailKey
        && emailKey.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        /* beta.4: an email that already has an account cannot apply. */
        && !exists(/databases/$(database)/documents/accountEmails/$(emailKey));
      allow read, delete: if reviewer();
      /* beta.4: the applicant reads their own application, once their email
         is confirmed (to know whether it is still pending). */
      allow get: if verifiedEmail() && myEmailKey() == emailKey;
      /* beta.4: an automatically approved applicant, now in the public group,
         marks their own application approved. */
      allow update: if verifiedEmail() && myEmailKey() == emailKey
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'golferId', 'golferName', 'reviewedAt', 'auto'])
        && request.resource.data.status == 'approved'
        && request.resource.data.auto == true
        && request.resource.data.reviewedAt == request.time
        && exists(/databases/$(database)/documents/associations/$(publicId())/members/$(request.auth.uid))
        && request.resource.data.golferId == myGolferIn(publicId());
      /* Go-live fix 2: an approval is claimed first (pending → approving, by
         one reviewer), then finished (approving → approved, by that same
         reviewer), or released back to pending. A second reviewer cannot take
         an approval in progress unless it has been stuck for 10 minutes.
         Rejecting is only possible while pending. */
      allow update: if reviewer()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'golferId', 'golferName', 'approvingAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'approving'
            && request.resource.data.approvingAt == request.time
            && request.resource.data.golferId is string
            && request.resource.data.golferName is string
            /* beta.4: not while the applicant's own Auto approval exists. */
            && !exists(approvalPath(emailKey)))
          || (resource.data.status == 'approving'
            && request.resource.data.status == 'approving'
            && request.resource.data.approvingAt == request.time
            && (resource.data.reviewedBy == request.auth.uid
                || request.time > resource.data.approvingAt + duration.value(10, 'm')))
          || (resource.data.status == 'approving'
            && resource.data.reviewedBy == request.auth.uid
            && request.resource.data.status in ['approved', 'pending'])
          || (resource.data.status == 'pending'
            && request.resource.data.status == 'rejected')
        );
    }

    /* beta.3: a request for a private group, written signed out. Only the
       group creator (Willy) reads and decides it. Approving claims it first
       with the new group's id (pending → approving), then marks it approved;
       it can be released back to pending, or declined while not approved. */
    match /groupRequests/{emailKey} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'email', 'groupName', 'golfers', 'where', 'note', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['fullName', 'email', 'groupName', 'golfers', 'where', 'note', 'status', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.lower() == emailKey
        && emailKey.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() >= 2
        && request.resource.data.groupName.size() <= 60
        && request.resource.data.golfers is string
        && request.resource.data.golfers.size() >= 1
        && request.resource.data.golfers.size() <= 20
        && request.resource.data.where is string
        && request.resource.data.where.size() >= 2
        && request.resource.data.where.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if groupCreator();
      allow update: if groupCreator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'groupId'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (
          (resource.data.status in ['pending', 'approving']
            && request.resource.data.status == 'approving'
            && request.resource.data.groupId is string
            && request.resource.data.groupId.size() > 0
            && request.resource.data.groupId.size() <= 64)
          || (resource.data.status == 'approving'
            && request.resource.data.status in ['approved', 'pending']
            && request.resource.data.groupId == resource.data.groupId)
          || (resource.data.status in ['pending', 'approving']
            && request.resource.data.status == 'declined')
        );
    }

    /* Written by a reviewer on approval. The applicant's app reads it once the
       email is confirmed, joins the PUBLIC group with it, then removes it. */
    match /publicApprovals/{emailKey} {
      allow read: if reviewer() || (verifiedEmail() && myEmailKey() == emailKey);
      /* Go-live fix 2: created once, only by the reviewer holding the claim on
         the application, and only for the golfer named in that claim. */
      /* beta.4: or by the applicant themselves, when the switch is Auto and
         every Level 1 check passes (autoSelfApproval). */
      allow create: if autoSelfApproval(emailKey) || reviewer()
        && request.resource.data.keys().hasOnly(['golferId', 'displayName', 'approvedBy', 'approvedAt'])
        && request.resource.data.approvedBy == request.auth.uid
        && get(/databases/$(database)/documents/publicApplications/$(emailKey)).data.status == 'approving'
        && get(/databases/$(database)/documents/publicApplications/$(emailKey)).data.reviewedBy == request.auth.uid
        && request.resource.data.golferId == get(/databases/$(database)/documents/publicApplications/$(emailKey)).data.golferId;
      allow delete: if reviewer()
        || (verifiedEmail() && myEmailKey() == emailKey
            && exists(/databases/$(database)/documents/associations/$(publicId())/members/$(request.auth.uid)));
    }

    /* ---------------- beta.4: applications switch ---------------- */

    /* Manual or Auto, and the daily limit. Anyone may read it (the
       application form says what will happen); Willy and the public group's
       reviewers change it. */
    match /settings/{settingId} {
      allow get: if settingId == 'publicApplications';
      allow create, update: if settingId == 'publicApplications'
        && (reviewer() || groupCreator())
        && request.resource.data.keys().hasOnly(['mode', 'dailyLimit', 'updatedBy', 'updatedAt'])
        && request.resource.data.mode in ['manual', 'auto']
        && request.resource.data.dailyLimit is int
        && request.resource.data.dailyLimit >= 1
        && request.resource.data.dailyLimit <= 500
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    /* Block lists, checked by the rules for every automatic approval. */
    match /blockedEmails/{key} {
      allow read, delete: if reviewer();
      allow create, update: if reviewer()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid;
    }
    match /blockedDomains/{key} {
      allow read, delete: if reviewer();
      allow create, update: if reviewer()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid;
    }
    match /blockedNames/{key} {
      allow read, delete: if reviewer();
      allow create, update: if reviewer()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid;
    }

    /* One entry per email that has an account. Anyone may ask about ONE email
       (so the form can say "already has an account"); nobody can list them.
       Each account writes or removes only its own. */
    match /accountEmails/{emailKey} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && !deleting() && myEmailKey() == emailKey
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && myEmailKey() == emailKey;
    }

    /* The day's count of automatic approvals (day = days since 1970, UTC).
       It moves by exactly one, only in the same batch as an automatic
       approval, and that approval is refused above the daily limit. */
    match /autoApprovals/{dayKey} {
      allow get: if signedIn();
      allow create: if dayKey == todayKey()
        && request.resource.data.keys().hasOnly(['count', 'lastBy', 'lastAt'])
        && request.resource.data.count == 1
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.lastAt == request.time
        && autoApprovalInThisBatch();
      allow update: if dayKey == todayKey()
        && request.resource.data.keys().hasOnly(['count', 'lastBy', 'lastAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.lastAt == request.time
        && autoApprovalInThisBatch();
    }

    /* Each account's own list of golfers it has blocked (Apple guideline 1.2).
       The app hides them; nobody else can see the list. */
    match /userBlocks/{userId}/golfers/{golferId} {
      allow read, delete: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn() && !deleting() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'blockedAt'])
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 120;
    }

    /* Phase D: who may create groups. You may check your own entry; nobody
       can list it, and no app can write it (the setup script does). */
    match /groupCreators/{userId} {
      allow get: if signedIn() && userId == request.auth.uid;
      allow list, write: if false;
    }

    /* ---------------- account deletion requests ---------------- */

    /* The daily admin job treats the document contents as untrusted. */
    match /accountDeletions/{userId} {
      allow read: if authed() && userId == request.auth.uid;
      /* beta.9: a request starts as "requested". It may be withdrawn (deleted)
         only before anything has been removed — "requested" (a wrong
         password) or "reauthenticated" (the person turned out to own a group)
         — and never moved back to those stages afterwards. So once removal has
         begun, the lock stays until the deletion is finished. */
      allow create: if authed() && userId == request.auth.uid
        && request.resource.data.stage == 'requested';
      allow update: if authed() && userId == request.auth.uid
        && (!(request.resource.data.get('stage', '') in ['requested', 'reauthenticated'])
            || resource.data.get('stage', '') in ['requested', 'reauthenticated']);
      allow delete: if authed() && userId == request.auth.uid
        && resource.data.get('stage', '') in ['requested', 'reauthenticated'];
    }

    /* ---------------- join codes ---------------- */

    /* A tiny index: code -> group. Without it, somebody given only a code has
       no way to discover which group it belongs to, because group documents
       are readable by members only.
       Readable by anyone signed in, which is safe: knowing that a code exists
       gets you nothing. Joining still requires presenting the matching code,
       and that check happens against the group document itself. */
    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/associations/$(request.resource.data.assocId)).data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    /* ---------------- version 1 data, kept readable ---------------- */

    /* The version 1 single-document scorecard still lives here.
     *
     * Full read AND write, deliberately. Publishing these rules must not break
     * version 1 — it keeps running, keeps saving, and stays your fallback until
     * you have checked that version 2 holds everything correctly. The two apps
     * write to different places and cannot disturb one another.
     *
     * Once you no longer need version 1, this block can be changed to read-only
     * or removed. Not before. */
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ---------------- courses: shared across every group ---------------- */

    match /courses/{courseId} {

      /* Readable by anyone signed in. This is the point of the collection —
         one entry for Royal Ontario, read by every group, entered once. */
      allow read: if signedIn();

      allow create: if signedIn() && !deleting()
        && request.resource.data.createdBy == request.auth.uid;

      /* Only whoever added a course may change it. A shared library invites
         well-meaning edits that break other groups' data, so version 3 should
         replace this with a curated review step. Until then, ratings that are
         wrong get a new course entry rather than an edit war. */
      allow update: if signedIn() && !deleting() && resource.data.createdBy == request.auth.uid;

      allow delete: if false;   /* rounds reference courses; never orphan them */
    }
  }
}

