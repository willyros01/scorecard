{
  "name": "the-scorecard",
  "version": "2.22.0",
  "private": true,
  "description": "The Scorecard: one code base for the web app and the iPhone app. This file is used only by the build and the automated tests; the web app itself needs no build step.",
  "scripts": {
    "bundle": "esbuild build/firebase-entry.js --bundle --format=esm --minify --legal-comments=none --target=es2020 --outfile=vendor/firebase/firebase-10.12.0.js",
    "verify": "bash build/verify.sh",
    "web-tests": "node test/web/run.mjs"
  },
  "dependencies": {
    "firebase": "10.12.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/app-launcher": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
